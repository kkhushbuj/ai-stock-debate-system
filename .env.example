# --- LLM providers ---
OPENAI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
# Llama runs through OpenRouter. One shared key, or separate keys per company (Llama / Claude) if you prefer.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_LLAMA=
OPENROUTER_API_KEY_CLAUDE=

# --- Data providers ---
TAVILY_API_KEY=
FRED_API_KEY=

# --- Model selection (overridable, defaults live in config.py) ---
DEBATER_A_MODEL=gemini-3.5-flash-lite
DEBATER_B_MODEL=ministral-3b-latest
JUDGE_MODEL=gpt-4.1-mini

# --- Backtest mode ---
# When "true", cache.py ignores TTLs and never re-fetches during a run,
# so every factor (including News Sentiment) is frozen for the session.
FREEZE_DATA_FOR_BACKTEST=false
# Gemini (Debater A)
GEMINI_API_KEY=
